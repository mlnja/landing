---
import { getCollection } from 'astro:content';
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const teamMembers = await getCollection('team', ({ data }) => !data.draft);
  return teamMembers.map((member) => ({
    params: { slug: member.id },
    props: { member },
  }));
}

const { member } = Astro.props;
const person = member.data;

// Convert links object to array for rendering
const linksArray = Object.entries(person.links)
  .filter(([_, url]) => url)
  .map(([net, href]) => {
    const handle = net === 'email'
      ? href.replace('mailto:', '')
      : href.replace(/https?:\/\//, '').split('/').pop() || '';
    return { net, href, handle: `@${handle}` };
  });

// Extract avatar src for script (can't serialize image object)
const avatarSrc = person.avatar.src.src;
---

<Layout title={`Connect · ${person.firstName} ${person.lastName} — MLOps.Ninja`} active="about">
  <div class="cnct">
    <div class="cnct__inner">
      <!-- QR Code Card -->
      <div class="cnct__card">
        <div class="cnct__qrwrap">
          <canvas id="cnct-qr" class="cnct__qr"></canvas>
        </div>
        <div class="cnct__id">
          <h1 class="cnct__name">{person.firstName} {person.lastName}</h1>
          <div class="cnct__role"><b>{person.org}</b> · {person.role}</div>
        </div>
        <div class="cnct__scan">Scan to connect</div>
      </div>

      <!-- Links Panel -->
      <div class="cnct__panel">
        <div class="cnct__links">
          {person.links.x && (
            <a href={person.links.x} class="cnct__link" target="_blank" rel="noopener">
              <span class="icon" data-net="x"></span>
              <span class="net">
                <b>X</b>
                <span>{person.handle}</span>
              </span>
            </a>
          )}
          {person.links.threads && (
            <a href={person.links.threads} class="cnct__link" target="_blank" rel="noopener">
              <span class="icon" data-net="threads"></span>
              <span class="net">
                <b>Threads</b>
                <span>{person.handle}</span>
              </span>
            </a>
          )}
          {person.links.linkedin && (
            <a href={person.links.linkedin} class="cnct__link" target="_blank" rel="noopener">
              <span class="icon" data-net="linkedin"></span>
              <span class="net">
                <b>LinkedIn</b>
                <span>{person.links.linkedin.split('/').pop()}</span>
              </span>
            </a>
          )}
          {person.links.github && (
            <a href={person.links.github} class="cnct__link" target="_blank" rel="noopener">
              <span class="icon" data-net="github"></span>
              <span class="net">
                <b>GitHub</b>
                <span>{person.handle}</span>
              </span>
            </a>
          )}
          {person.links.telegram && (
            <a href={person.links.telegram} class="cnct__link" target="_blank" rel="noopener">
              <span class="icon" data-net="telegram"></span>
              <span class="net">
                <b>Telegram</b>
                <span>{person.handle}</span>
              </span>
            </a>
          )}
          {person.links.email && (
            <a href={person.links.email} class="cnct__link" target="_blank" rel="noopener">
              <span class="icon" data-net="email"></span>
              <span class="net">
                <b>Email</b>
                <span>{person.links.email.replace('mailto:', '')}</span>
              </span>
            </a>
          )}
        </div>
        <button class="cnct__vcard" id="save-vcard">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
          </svg>
          Save to contacts
        </button>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ person, avatarSrc }}>
  // Network icons
  const NET = {
    x: { color: "#000000", path: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z" },
    threads: { color: "#000000", path: "M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.358-.218-3.255-.801-1.06-.69-1.68-1.74-1.746-2.964-.068-1.19.4-2.286 1.32-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.583-1.308-.881-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.321.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69c-.242 0-.487.007-.739.021-1.836.103-2.98.946-2.916 2.143.067 1.256 1.452 1.839 2.784 1.767 1.224-.066 2.818-.543 3.086-3.71a10.276 10.276 0 0 0-2.215-.221z" },
    linkedin: { color: "#0A66C2", path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" },
    github: { color: "#000000", path: "M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z" },
    telegram: { color: "#229ED9", path: "M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" },
    email: { color: "#0ea5e9", path: "M3 6.5h18v11H3zM3.5 7l8.5 6 8.5-6", stroke: true }
  };

  // Render network icons
  document.querySelectorAll('.icon[data-net]').forEach(el => {
    const net = el.getAttribute('data-net');
    const n = NET[net];
    if (!n) return;

    if (n.stroke) {
      el.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="${n.color}" stroke-width="1.7"><path d="${n.path}"/></svg>`;
    } else {
      el.innerHTML = `<svg viewBox="0 0 24 24" fill="${n.color}"><path d="${n.path}"/></svg>`;
    }
  });

  // Load QR library and generate QR code with photo
  const script = document.createElement('script');
  script.src = '/qrcode.min.js';
  script.onload = function() {
    const canvas = document.getElementById('cnct-qr');
    if (!canvas || typeof qrcode === 'undefined') return;

    const text = person.url;
    let qr = null;
    for (let t = 2; t <= 20 && !qr; t++) {
      try {
        const cand = qrcode(t, 'H');
        cand.addData(text);
        cand.make();
        qr = cand;
      } catch (e) {
        qr = null;
      }
    }
    if (!qr) return;

    const count = qr.getModuleCount();
    const quiet = 2;
    const total = count + quiet * 2;
    const dpr = Math.max(1, window.devicePixelRatio || 1);
    const cssTarget = canvas.clientWidth || 300;
    const scale = Math.max(2, Math.floor((cssTarget * dpr) / total));
    const dim = total * scale;

    canvas.width = dim;
    canvas.height = dim;

    const ctx = canvas.getContext('2d');
    const ink = '#131b2e';

    // Background
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, dim, dim);

    // Modules
    ctx.fillStyle = ink;
    for (let r = 0; r < count; r++) {
      for (let c = 0; c < count; c++) {
        if (qr.isDark(r, c)) {
          ctx.fillRect((c + quiet) * scale, (r + quiet) * scale, scale, scale);
        }
      }
    }

    // Load and draw photo in center
    const img = new Image();
    img.onload = function() {
      const codePx = count * scale;
      const logoSide = Math.round(codePx * 0.26);
      const pad = Math.round(scale * 1.4);
      const cx = dim / 2;
      const cy = dim / 2;
      const rOuter = logoSide / 2 + pad;

      // White knockout disc
      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, rOuter, 0, Math.PI * 2);
      ctx.fillStyle = '#ffffff';
      ctx.fill();
      ctx.restore();

      // Circular photo
      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, logoSide / 2, 0, Math.PI * 2);
      ctx.clip();

      const iw = img.naturalWidth;
      const ih = img.naturalHeight;
      const side = Math.min(iw, ih) * 0.72;
      let sx = iw / 2 - side / 2;
      let sy = ih * 0.44 - side * 0.40;
      sx = Math.max(0, Math.min(sx, iw - side));
      sy = Math.max(0, Math.min(sy, ih - side));

      ctx.drawImage(img, sx, sy, side, side, cx - logoSide / 2, cy - logoSide / 2, logoSide, logoSide);
      ctx.restore();

      // Thin ring
      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, logoSide / 2, 0, Math.PI * 2);
      ctx.lineWidth = Math.max(1, scale * 0.5);
      ctx.strokeStyle = 'rgba(19,27,46,0.12)';
      ctx.stroke();
      ctx.restore();
    };
    img.src = avatarSrc;
  };
  document.head.appendChild(script);

  // VCard download
  document.getElementById('save-vcard').addEventListener('click', () => {
    const fullName = `${person.firstName} ${person.lastName}`;

    const vcardLines = [
      'BEGIN:VCARD',
      'VERSION:3.0',
      `N:${person.lastName};${person.firstName};;;`,
      `FN:${fullName}`
    ];

    if (person.org) vcardLines.push(`ORG:${person.org}`);
    if (person.role) vcardLines.push(`TITLE:${person.role}`);

    // Add all social links
    if (person.links.email) {
      const email = person.links.email.replace('mailto:', '');
      vcardLines.push(`EMAIL;TYPE=INTERNET:${email}`);
    }
    if (person.links.telegram) {
      vcardLines.push(`X-SOCIALPROFILE;TYPE=telegram:${person.links.telegram}`);
    }
    if (person.links.x) {
      vcardLines.push(`X-SOCIALPROFILE;TYPE=twitter:${person.links.x}`);
    }
    if (person.links.threads) {
      vcardLines.push(`X-SOCIALPROFILE;TYPE=threads:${person.links.threads}`);
    }
    if (person.links.linkedin) {
      vcardLines.push(`X-SOCIALPROFILE;TYPE=linkedin:${person.links.linkedin}`);
    }
    if (person.links.github) {
      vcardLines.push(`X-SOCIALPROFILE;TYPE=github:${person.links.github}`);
    }
    if (person.url) {
      vcardLines.push(`URL;TYPE=WORK:${person.url}`);
    }

    vcardLines.push('END:VCARD');
    const vcard = vcardLines.join('\r\n');

    const blob = new Blob([vcard], { type: 'text/vcard;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${person.firstName.toLowerCase()}-${person.lastName.toLowerCase()}.vcf`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });
</script>

<style>
  .cnct {
    min-height: calc(100vh - 69px);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    padding: clamp(28px, 5vh, 56px) 20px;
  }
  .cnct__inner {
    display: grid;
    grid-template-columns: auto minmax(280px, 360px);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    width: 100%;
    max-width: 880px;
  }
  .cnct__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .cnct__qrwrap {
    padding: 12px;
    background: #fff;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-float);
    line-height: 0;
  }
  .cnct__qr {
    display: block;
    width: min(300px, 72vw);
    height: min(300px, 72vw);
  }
  .cnct__id {
    text-align: center;
    width: 300px;
    max-width: 100%;
  }
  .cnct__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(22px, 6vw, 26px);
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.1;
    color: var(--on-surface);
    text-wrap: balance;
  }
  .cnct__role {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-surface-muted);
    margin-top: 9px;
  }
  .cnct__role b {
    color: var(--on-surface-variant);
    font-weight: 500;
  }
  .cnct__scan {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-surface-muted);
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .cnct__scan::before {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--secondary-container);
  }
  .cnct__panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .cnct__links {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    width: 100%;
  }
  .cnct__link {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 12px 14px;
    background: var(--surface-container-lowest);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-sm);
    color: var(--on-surface);
    text-decoration: none;
    transition: border-color 150ms ease, transform 150ms ease;
    min-height: 52px;
  }
  .cnct__link:hover {
    border-color: var(--on-surface);
    transform: translateY(-1px);
  }
  .cnct__link .icon {
    flex-shrink: 0;
  }
  .cnct__link .icon :global(svg) {
    width: 21px;
    height: 21px;
    display: block;
  }
  .cnct__link .net {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }
  .cnct__link .net b {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14.5px;
  }
  .cnct__link .net span {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--on-surface-muted);
    font-weight: 400;
    letter-spacing: 0.01em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cnct__vcard {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px;
    background: var(--on-surface);
    color: var(--surface-container-lowest);
    border: 0;
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    transition: background 150ms ease;
  }
  .cnct__vcard:hover {
    background: #000;
  }
  .cnct__vcard svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 760px) {
    .cnct {
      align-items: flex-start;
    }
    .cnct__inner {
      grid-template-columns: 1fr;
      gap: clamp(18px, 3vh, 26px);
      max-width: 460px;
      justify-items: center;
    }
    .cnct__panel {
      width: 100%;
    }
    .cnct__links {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 380px) {
    .cnct__links {
      grid-template-columns: 1fr;
    }
  }
</style>
