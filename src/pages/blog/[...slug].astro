---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const teamMembers = await getCollection('team');

  return posts.map((post) => {
    const slug = post.id.split('/').pop()?.replace(/\.(md|mdx)$/, '') || post.id;
    const author = teamMembers.find(m => m.id === post.data.author || m.data.firstName.toLowerCase() === post.data.author);
    return {
      params: { slug },
      props: { post, author },
    };
  });
}

const { post, author } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} · MLOps.Ninja`}
  description={post.data.snippet}
  active="blog"
  image={post.data.cover?.src.src || "/assets/og-image.png"}
  article={true}
>
  <!-- Post Meta -->
  <section class="post-meta">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/blog">Blog</a>
        <span class="sep">/</span>
        <span>{post.data.title}</span>
      </div>

      <div class="post-cat">
        {post.data.lifecycle && <span>{post.data.lifecycle}</span>}
        {post.data.lifecycleSection && (
          <>
            <span class="sep">·</span>
            <span>{post.data.lifecycleSection}</span>
          </>
        )}
      </div>

      <h1 class="post-title">{post.data.title}</h1>

      <div class="post-byline">
        {author ? (
          <>
            <a class="avatar" href={`/connect/${author.id}`} aria-label={`Connect with ${author.data.firstName} ${author.data.lastName}`}>
              <Image
                src={author.data.avatar.src}
                alt={author.data.avatar.alt}
                width={72}
                height={72}
              />
            </a>
            <a class="author-info" href={`/connect/${author.id}`}>
              <span class="name">{author.data.firstName} {author.data.lastName}</span>
              <span class="meta">
                {new Date(post.data.publishDate).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </span>
            </a>
          </>
        ) : (
          <>
            <div class="avatar">
              {post.data.author.charAt(0).toUpperCase()}
            </div>
            <div class="author-info">
              <span class="name">{post.data.author}</span>
              <span class="meta">
                {new Date(post.data.publishDate).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </span>
            </div>
          </>
        )}
        {post.data.tags && (
          <div class="post-tags">
            {post.data.tags.slice(0, 3).map(tag => (
              <span class="post-tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Hero Image -->
  <section class="container">
    {post.data.cover?.src && (
      <div class="post-hero-wrap">
        <div class="post-hero">
          <Image
            src={post.data.cover.src}
            alt={post.data.cover.alt}
            widths={[800, 1200, 1600]}
            sizes="100vw"
            class="post-hero__image"
          />
        </div>
      </div>
    )}
    <div class="post-hero-rule"></div>
  </section>

  <!-- Article Body -->
  <article class="article">
    <Content />
  </article>

  <!-- Author Bio -->
  {author && (
    <section class="container">
      <div class="post-foot">
        <div class="post-foot__author">
          <a class="avatar" href={`/connect/${author.id}`} aria-label={`Connect with ${author.data.firstName} ${author.data.lastName}`}>
            <Image
              src={author.data.avatar.src}
              alt={author.data.avatar.alt}
              width={120}
              height={120}
            />
          </a>
          <div>
            <p class="name">{author.data.firstName} {author.data.lastName}</p>
            <p class="bio">{author.data.bio}</p>
          </div>
          <a class="more" href={`/connect/${author.id}`}>
            Connect with {author.data.firstName} →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Comments -->
  <section class="container">
    <div class="comments-section">
      <div class="comments-header">
        <h2>Discussion</h2>
        <p>Leave a comment below. Comments are powered by GitHub Discussions.</p>
      </div>
      <div class="giscus-container">
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo="mlops-ninja/landing"
          data-repo-id="R_kgDOM4cDNA"
          data-category="General"
          data-category-id="DIC_kwDOM4cDNM4Crcwe"
          data-mapping="og:title"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme={`${Astro.url.origin}/themes/custom.css`}
          data-lang="en"
          data-loading="lazy"
          crossorigin="anonymous"
          async>
        </script>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Post Meta */
  .post-meta {
    padding: var(--space-7) 0 var(--space-4);
  }
  .breadcrumbs {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-surface-muted);
    margin-bottom: var(--space-3);
  }
  .breadcrumbs a {
    color: var(--on-surface-muted);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    color: var(--on-surface);
  }
  .breadcrumbs .sep {
    margin: 0 8px;
    color: var(--outline-variant);
  }

  .post-cat {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--primary-container);
    margin-bottom: var(--space-3);
  }
  .post-cat .sep {
    color: var(--outline-variant);
    margin: 0 10px;
  }

  .post-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(40px, 5.5vw, 76px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-4);
  }

  .post-byline {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }
  .post-byline .avatar {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, rgba(14,165,233,.4), rgba(234,87,255,.4));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    color: #fff;
    font-size: 13px;
    overflow: hidden;
    text-decoration: none;
  }
  .post-byline .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.5);
    transform-origin: center 30%;
    display: block;
  }
  .post-byline .author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    cursor: pointer;
  }
  .post-byline .author-info:hover .name {
    color: var(--primary);
  }
  .post-byline .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    color: var(--on-surface);
    transition: color 150ms;
  }
  .post-byline .meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-surface-muted);
    letter-spacing: 0.04em;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-left: auto;
  }
  .post-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--on-surface-variant);
    padding: 5px 9px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    letter-spacing: 0.04em;
  }

  /* Hero Image */
  .post-hero-wrap {
    text-align: center;
    margin-bottom: var(--space-6);
  }
  .post-hero {
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow-float);
    position: relative;
    overflow: hidden;
    max-height: 500px;
    display: inline-block;
    max-width: 100%;
  }
  .post-hero__image {
    width: auto;
    height: auto;
    max-height: 500px;
    max-width: 100%;
    display: block;
  }
  .post-hero-rule {
    height: 2px;
    margin: 0 auto var(--space-5);
    max-width: 280px;
    background: linear-gradient(90deg, transparent, rgba(234,87,255,.5), rgba(14,165,233,.5), transparent);
  }

  /* Article Body */
  .article {
    max-width: 740px;
    margin: 0 auto;
    padding: 0 0 var(--space-9);
  }

  /* Author Bio */
  .post-foot {
    max-width: 740px;
    margin: 0 auto;
    padding: var(--space-5) 0 var(--space-7);
    border-top: 1px solid var(--hairline);
  }
  .post-foot__author {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    gap: var(--space-3);
    align-items: center;
  }
  .post-foot__author .avatar {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, rgba(14,165,233,.4), rgba(234,87,255,.4));
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .post-foot__author .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.5);
    transform-origin: center 30%;
    display: block;
  }
  .post-foot__author .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    margin: 0;
  }
  .post-foot__author .bio {
    font-size: 13.5px;
    color: var(--on-surface-variant);
    margin: 4px 0 0;
  }
  .post-foot__author .more {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-surface);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .post-foot__author .more:hover {
    color: var(--primary);
  }

  /* Comments */
  .comments-section {
    max-width: 740px;
    margin: 0 auto;
    padding: var(--space-6) 0 var(--space-8);
  }
  .comments-header {
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--hairline);
  }
  .comments-header h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    letter-spacing: -0.015em;
    margin: 0 0 8px;
  }
  .comments-header p {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-surface-muted);
    letter-spacing: 0.04em;
    margin: 0;
  }
  .giscus-container {
    margin-top: var(--space-4);
  }

  /* Giscus custom styling */
  .giscus-container :global(.giscus) {
    font-family: var(--font-body);
  }
  .giscus-container :global(.giscus-frame) {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    background: var(--surface-container-lowest);
  }

  @media (max-width: 760px) {
    .article {
      padding-left: 20px;
      padding-right: 20px;
    }
    .post-foot__author {
      grid-template-columns: 60px 1fr;
      gap: var(--space-2);
    }
    .post-foot__author .more {
      grid-column: 1 / -1;
      text-align: center;
    }
    .comments-section {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
