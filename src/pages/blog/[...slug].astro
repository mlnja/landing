---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const teamMembers = await getCollection('team');

  return posts.map((post) => {
    const slug = post.id.split('/').pop()?.replace(/\.(md|mdx)$/, '') || post.id;
    const author = teamMembers.find(m => m.id === post.data.author || m.data.firstName.toLowerCase() === post.data.author);
    return {
      params: { slug },
      props: { post, author },
    };
  });
}

const { post, author } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} · MLOps.Ninja`}
  description={post.data.snippet}
  active="blog"
  image={post.data.cover?.src.src || "/assets/og-image.png"}
  article={true}
>
  <!-- Post Meta -->
  <section class="post-meta">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/blog">Blog</a>
        <span class="sep">/</span>
        <span>{post.data.title}</span>
      </div>

      <div class="post-cat">
        {post.data.lifecycle && <span>{post.data.lifecycle}</span>}
        {post.data.lifecycleSection && (
          <>
            <span class="sep">·</span>
            <span>{post.data.lifecycleSection}</span>
          </>
        )}
      </div>

      <h1 class="post-title">{post.data.title}</h1>

      <div class="post-byline">
        {author ? (
          <>
            <a class="avatar" href={`/connect/${author.id}`} aria-label={`Connect with ${author.data.firstName} ${author.data.lastName}`}>
              <Image
                src={author.data.avatar.src}
                alt={author.data.avatar.alt}
                width={72}
                height={72}
              />
            </a>
            <a class="author-info" href={`/connect/${author.id}`}>
              <span class="name">{author.data.firstName} {author.data.lastName}</span>
              <span class="meta">
                {new Date(post.data.publishDate).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </span>
            </a>
          </>
        ) : (
          <>
            <div class="avatar">
              {post.data.author.charAt(0).toUpperCase()}
            </div>
            <div class="author-info">
              <span class="name">{post.data.author}</span>
              <span class="meta">
                {new Date(post.data.publishDate).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </span>
            </div>
          </>
        )}
        {post.data.tags && (
          <div class="post-tags">
            {post.data.tags.slice(0, 3).map(tag => (
              <span class="post-tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Hero Image -->
  <section class="container">
    {post.data.cover?.src && (
      <div class="post-hero-wrap">
        <div class="post-hero">
          <Image
            src={post.data.cover.src}
            alt={post.data.cover.alt}
            widths={[800, 1200, 1600]}
            sizes="100vw"
            class="post-hero__image"
          />
        </div>
      </div>
    )}
    <div class="post-hero-rule"></div>
  </section>

  <!-- Article Body -->
  <article class="article">
    <Content />
  </article>

  <!-- Author Bio -->
  {author && (
    <section class="container">
      <div class="post-foot">
        <div class="post-foot__author">
          <a class="avatar" href={`/connect/${author.id}`} aria-label={`Connect with ${author.data.firstName} ${author.data.lastName}`}>
            <Image
              src={author.data.avatar.src}
              alt={author.data.avatar.alt}
              width={120}
              height={120}
            />
          </a>
          <div>
            <p class="name">{author.data.firstName} {author.data.lastName}</p>
            <p class="bio">{author.data.bio}</p>
          </div>
          <a class="more" href={`/connect/${author.id}`}>
            Connect with {author.data.firstName} →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Discussion -->
  <section class="container">
    <div class="share-section">
      <div class="share-header">
        <h2>Want to comment?</h2>
        <p>Reply on your platform of choice and tag {author ? `@${author.data.handle.replace('@', '')}` : '@virviil'} — I read everything.</p>
      </div>
      <div class="share-buttons">
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`@${author ? author.data.handle.replace('@', '') : 'virviil'} RE: ${post.data.title}`)}&url=${encodeURIComponent(Astro.url.href)}`}
          target="_blank"
          rel="noopener"
          class="share-btn share-btn--x"
          aria-label="Reply on X">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/>
          </svg>
          Reply on X
        </a>
        <a
          href={`https://threads.net/intent/post?text=${encodeURIComponent(`@${author ? author.data.handle.replace('@', '') : 'virviil'} RE: ${post.data.title}\n${Astro.url.href}`)}`}
          target="_blank"
          rel="noopener"
          class="share-btn share-btn--threads"
          aria-label="Reply on Threads">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.358-.218-3.255-.801-1.06-.69-1.68-1.74-1.746-2.964-.068-1.19.4-2.286 1.32-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.583-1.308-.881-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.321.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69c-.242 0-.487.007-.739.021-1.836.103-2.98.946-2.916 2.143.067 1.256 1.452 1.839 2.784 1.767 1.224-.066 2.818-.543 3.086-3.71a10.276 10.276 0 0 0-2.215-.221z"/>
          </svg>
          Reply on Threads
        </a>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
          target="_blank"
          rel="noopener"
          class="share-btn share-btn--linkedin"
          aria-label="Discuss on LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
          </svg>
          Discuss on LinkedIn
        </a>
        <a
          href={`https://news.ycombinator.com/submitlink?u=${encodeURIComponent(Astro.url.href)}&t=${encodeURIComponent(post.data.title)}`}
          target="_blank"
          rel="noopener"
          class="share-btn share-btn--hn"
          aria-label="Discuss on Hacker News">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M0 24V0h24v24H0zM6.951 5.896l4.112 7.708v5.064h1.583v-4.972l4.148-7.799h-1.749l-2.457 4.875c-.372.745-.688 1.434-.688 1.434s-.297-.708-.651-1.434L8.831 5.896h-1.88z"/>
          </svg>
          Discuss on HN
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Post Meta */
  .post-meta {
    padding: var(--space-7) 0 var(--space-4);
  }
  .breadcrumbs {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-surface-muted);
    margin-bottom: var(--space-3);
  }
  .breadcrumbs a {
    color: var(--on-surface-muted);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    color: var(--on-surface);
  }
  .breadcrumbs .sep {
    margin: 0 8px;
    color: var(--outline-variant);
  }

  .post-cat {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--primary-container);
    margin-bottom: var(--space-3);
  }
  .post-cat .sep {
    color: var(--outline-variant);
    margin: 0 10px;
  }

  .post-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(40px, 5.5vw, 76px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-4);
  }

  .post-byline {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }
  .post-byline .avatar {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, rgba(14,165,233,.4), rgba(234,87,255,.4));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    color: #fff;
    font-size: 13px;
    overflow: hidden;
    text-decoration: none;
  }
  .post-byline .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.5);
    transform-origin: center 30%;
    display: block;
  }
  .post-byline .author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    cursor: pointer;
  }
  .post-byline .author-info:hover .name {
    color: var(--primary);
  }
  .post-byline .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    color: var(--on-surface);
    transition: color 150ms;
  }
  .post-byline .meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-surface-muted);
    letter-spacing: 0.04em;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-left: auto;
  }
  .post-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--on-surface-variant);
    padding: 5px 9px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    letter-spacing: 0.04em;
  }

  /* Hero Image */
  .post-hero-wrap {
    text-align: center;
    margin-bottom: var(--space-6);
  }
  .post-hero {
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow-float);
    position: relative;
    overflow: hidden;
    max-height: 500px;
    display: inline-block;
    max-width: 100%;
  }
  .post-hero__image {
    width: auto;
    height: auto;
    max-height: 500px;
    max-width: 100%;
    display: block;
  }
  .post-hero-rule {
    height: 2px;
    margin: 0 auto var(--space-5);
    max-width: 280px;
    background: linear-gradient(90deg, transparent, rgba(234,87,255,.5), rgba(14,165,233,.5), transparent);
  }

  /* Article Body */
  .article {
    max-width: 740px;
    margin: 0 auto;
    padding: 0 0 var(--space-9);
  }

  /* Author Bio */
  .post-foot {
    max-width: 740px;
    margin: 0 auto;
    padding: var(--space-5) 0 var(--space-7);
    border-top: 1px solid var(--hairline);
  }
  .post-foot__author {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    gap: var(--space-3);
    align-items: center;
  }
  .post-foot__author .avatar {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, rgba(14,165,233,.4), rgba(234,87,255,.4));
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .post-foot__author .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.5);
    transform-origin: center 30%;
    display: block;
  }
  .post-foot__author .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    margin: 0;
  }
  .post-foot__author .bio {
    font-size: 13.5px;
    color: var(--on-surface-variant);
    margin: 4px 0 0;
  }
  .post-foot__author .more {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-surface);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .post-foot__author .more:hover {
    color: var(--primary);
  }

  /* Share */
  .share-section {
    padding: var(--space-6) 0 var(--space-8);
  }
  .share-header {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--hairline);
  }
  .share-header h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    letter-spacing: -0.015em;
    margin: 0 0 8px;
  }
  .share-header p {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-surface-muted);
    letter-spacing: 0.04em;
    margin: 0;
  }
  .share-buttons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-2);
  }
  .share-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 20px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    background: var(--surface-container-lowest);
    color: var(--on-surface);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: all 160ms ease;
    white-space: nowrap;
  }
  .share-btn svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }
  .share-btn:hover {
    transform: translateY(-1px);
  }
  .share-btn--x {
    border-color: #000;
  }
  .share-btn--x:hover {
    background: #000;
    color: #fff;
  }
  .share-btn--threads {
    border-color: #000;
  }
  .share-btn--threads:hover {
    background: #000;
    color: #fff;
  }
  .share-btn--linkedin {
    border-color: #0A66C2;
  }
  .share-btn--linkedin:hover {
    background: #0A66C2;
    color: #fff;
  }
  .share-btn--hn {
    border-color: #ff6600;
  }
  .share-btn--hn:hover {
    background: #ff6600;
    color: #fff;
  }

  @media (max-width: 760px) {
    .article {
      padding-left: 20px;
      padding-right: 20px;
    }
    .post-foot__author {
      grid-template-columns: 60px 1fr;
      gap: var(--space-2);
    }
    .post-foot__author .more {
      grid-column: 1 / -1;
      text-align: center;
    }
    .share-section {
      padding-left: 20px;
      padding-right: 20px;
    }
    .share-buttons {
      grid-template-columns: 1fr;
    }
  }
</style>
